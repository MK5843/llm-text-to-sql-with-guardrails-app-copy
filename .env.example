SECRET_KEY="your-secret-key-here" # This is a secret key used for session management and should be kept confidential. You can generate a new one using Python's secrets module: `python -c 'import secrets; print(secrets.token_hex(32))'`
ENCRYPTION_KEY="your-encryption-key-here" # This is a base64-encoded encryption key used for encrypting sensitive data. You can generate a new one using Python's secrets module: `python -c 'import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'`
DATABASE_URL="your-database-url-here" # This is the URL for your PostgreSQL database. It should be in the format: `postgresql://username:password@host:port/database_name`. Make sure to replace it with your actual database credentials.
GOOGLE_CLIENT_ID="your-google-client-id-here" # This is the client ID for your Google OAuth application. You can obtain it from the Google Cloud Console when you set up OAuth 2.0 credentials.
GOOGLE_CLIENT_SECRET="your-google-client-secret-here" # This is the client secret for your Google OAuth application. You can obtain it from the Google Cloud Console when you set up OAuth 2.0 credentials.
LLM_PROVIDER="lmstudio" # This is the LLM provider to use (e.g., lmstudio, openai, anthropic, gemini)
LLM_FALLBACK_ORDER="openai,claude,gemini" # This is the order in which to try LLM providers if one fails
LLM_BASE_URL="your-llm-base-url-here" # This is the base URL for your LLM provider (e.g., LM Studio, OpenAI, etc.)
LLM_MODEL="qwen2.5-coder-14b-instruct" # Your preferred LLM model
OPENAI_API_KEY="your-openai-api-key-here" # This is the API key for OpenAI. You can obtain it from the OpenAI platform when you create an API key.
ANTHROPIC_API_KEY="your-anthropic-api-key-here" # This is the API key for Anthropic. You can obtain it from the Anthropic platform when you create an API key.
GEMINI_API_KEY="your-gemini-api-key-here" # This is the API key for Gemini. You can obtain it from the Gemini platform when you create an API key.